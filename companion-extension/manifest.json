{
  "manifest_version": 3,
  "name": "UCAS Moodle Companion",
  "description": "With your permission, imports your own Moodle course links and supported lecture attachments directly into UCAS local study library. No passwords or cookies are copied.",
  "version": "0.4.0",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["https://moodle.ucas.edu.ps/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://moodle.ucas.edu.ps/*"],
      "js": ["moodle-reader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mmashharawi2021-cell.github.io/UCAS/*"],
      "js": ["ucas-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "UCAS Moodle Companion",
    "default_popup": "popup.html"
  }
}
